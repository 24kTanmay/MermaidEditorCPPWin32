config:
  layout: elk
  theme: redux
  look: neo
---
flowchart TB
 subgraph S1_Logic["Logic Flow"]
        S1_F1("main()<br>(Entry Point)")
        S1_Setup("Setup:<br>Load Model to CPU/GPU<br>Limit: RECORDS_TO_PROCESS")
        S1_Loop("Loop over records<br>(Iterate JSONL)")
        S1_F2("paraphrase_text()<br>(Core Function)")
        S1_Tok("Tokenizer<br>(Prefix: 'paraphrase: ' + text)")
        S1_Gen("model.generate()<br>(Run T5 Inference)")
        S1_Params("Params:<br>num_beams=5<br>num_return_sequences=1<br>max_length=128<br>truncation=True")
        S1_Aug("Augmentation<br>(Append '_aug' to ID)")
        S1_Write("Write JSONL<br>(Original + Augmented)")
  end
 subgraph Step1["Step 1: Data Augmentation"]
    direction TB
        S1_Input("data/python_data.json<br>(Original Dataset)")
        S1_Script("text2code_mrpt/paraphrase_dataset.py<br>(Augmentation Script)")
        S1_Model("T5 Model<br>(t5_paraphraser_model)")
        S1_Logic
        S1_Output("data_augmented/python_data.json<br>(Augmented Dataset)")
  end
 subgraph S2_Tokenization["Tokenization Logic (tokenization.py)"]
        S2_Script1("source/tokenization.py")
        S2_F1("tokenization_function_raw()<br>(Prepare Input)")
        S2_Sig("Extract Signature:<br>Find ':  '")
        S2_Seq("Sequence Construction:<br>[beginoftext] signature [comments] doc [python] code [eot]")
        S2_Special("Special Tokens Added:<br>&lt;eod&gt;, &lt;eot&gt;, &lt;pad&gt;, &lt;python&gt;, &lt;comments&gt;,<br>&lt;NEW_LINE&gt;, &lt;INDENT&gt;, &lt;DEDENT&gt;, &lt;mask&gt;")
        S2_Masks("Mask Generation:<br>code_mask: 1 for sig/code, 0 for doc<br>docstr_mask: 1 for sig/doc, 0 for code<br>prefix_lm_token_idx: len(sig+doc)")
  end
 subgraph S2_PES["PES Logic (lm_trainer.py)"]
        S2_Script2("source/lm_trainer.py")
        S2_Arg("Arg: --separate_some_embeds<br>or --separate_embeds")
        S2_Read("Read python_tokens.txt")
        S2_Map("Build replicated_tokens_map<br>(Map old ID to new ID)")
        S2_Vocab("Add Tokens to Vocab:<br>[_DUP_]def, [_DUP_]return...<br>(Appended to end of vocab)")
        S2_Init("Weight Initialization (Hack):<br>wte[tgt] = wte[src]<br>(Copy weights from original)")
  end
 subgraph Step2["Step 2: Tokenization & PES"]
    direction TB
        S2_Tokens("source/python_tokens.txt<br>(Keywords List)")
        S2_Tokenization
        S2_PES
  end
 subgraph S3_TrainingLogic["Training Process"]
        S3_Hyper("Hyperparams:<br>LR=1e-5, BS=8, ACC=4<br>Epochs=10, Warmup=0.01")
        S3_Args("Args:<br>--predict_code=True<br>--dataset_name=pycodegpt_partial_sep<br>--deepspeed=ds_config_s2_no_offload.json")
        S3_Class("CustomTrainer<br>(HuggingFace Trainer)")
        S3_Collator("DataCollatorWithPaddingForCLM<br>(Batching &amp; Padding)")
        S3_Batch("Batch Preparation:<br>Apply code_mask to labels")
        S3_Loss("Loss Calculation:<br>Ignore indices where code_mask=0<br>(Train only on code)")
        S3_Opt("Optimizer: AdamW<br>(Update Weights)")
        S3_Callback("GenerationCallback<br>(Log samples during training)")
  end
 subgraph Step3["Step 3: Training (Code-CLM)"]
    direction TB
        S3_RunScript("source/run_model.sh<br>(Launch Script)")
        S3_TrainerScript("source/lm_trainer.py<br>(Training Script)")
        S3_TrainingLogic
        S3_ModelOut("Trained Model Weights<br>(out_repo_run_pycodegpt/pytorch_model.bin)")
  end
 subgraph S4_Gen["Generation Phase (generation.py)"]
        S4_GenScript("source/generation.py")
        S4_DS("Dataset: PycodegptDataset<br>(Prepare Prompts)")
        S4_Prompt("Prompt Construction:<br>[beginoftext] signature [comments] doc [python]")
        S4_GenFunc("model.generate()<br>(Inference)")
        S4_GenParams("Params:<br>temp=0.95, top_p=0.8<br>num_return_sequences=200 (or 400 w/ filter)")
        S4_Post("post_process_generated_tokens()<br>(Clean Indentation &amp; Special Tokens)")
        S4_RawOut("samples_400.jsonl<br>(Raw Candidates)")
  end
 subgraph S4_Filt["Uncertainty Filtering Phase (filter_generations.py)"]
        S4_FiltScript("source/filter_generations.py")
        S4_FiltMain("main()")
        S4_Group("group_by_task()<br>(Cluster by Problem)")
        S4_Matrix("Distance Matrix Calculation<br>(All-vs-All, Parallel Pool)")
        S4_Dist("calc_distance_pair()<br>Lib: Levenshtein")
        S4_Agree("Calculate Agreement Score<br>(Count neighbors where dist &lt; len * 0.1)")
        S4_Select("Select Top k (200)<br>(Remove Outliers)")
        S4_FiltOut("samples_filtered_200.jsonl<br>(Best Candidates)")
  end
 subgraph Step4["Step 4: Evaluation Pipeline"]
    direction TB
        S4_OrchScript("source/geneval_uncertainty_filter.sh<br>(Orchestrator)")
        S4_HumanEval("HumanEval Dataset<br>(Test Problems)")
        S4_Gen
        S4_Filt
  end
 subgraph S5_Calc["Calculation Logic"]
        S5_Read("read_dataset(HumanEval)")
        S5_Exec("check_correctness()<br>(Test Runner)")
        S5_ExecLogic("Construct Python Script:<br>Imports + Prompt + Code + Test")
        S5_Thread("ThreadPoolExecutor<br>(Parallel Execution)")
        S5_Agg("Aggregation:<br>Macro (by Task ID)<br>Micro (by Base Task ID)")
        S5_Est("estimate_pass_at_k()<br>(Unbiased Estimator)")
        S5_Formula("Formula: 1 - C(n-c, k) / C(n, k)")
  end
 subgraph Step5["Step 5: Metrics Calculation"]
    direction TB
        S5_Wrapper("CodeGeeX/scripts/evaluate_humaneval_x.sh<br>(Wrapper)")
        S5_PyScript("CodeGeeX/.../evaluate_humaneval_x.py<br>(Metric Script)")
        S5_Calc
        S5_Result("Final Scores:<br>pass@1, pass@10, pass@100")
  end
