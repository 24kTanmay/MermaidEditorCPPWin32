<Window x:Class="Mermaid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mermaid"
        Title="Mermaid Editor" Height="600" Width="800"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <TabControl x:Name="EditorTabs" SelectionChanged="EditorTabs_SelectionChanged">
            <!-- Tabs will be added dynamically in code-behind -->
        </TabControl>
        <WebView2 x:Name="PreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <ToolBar>
            <Button Content="New" Click="NewTab_Click" />
            <Button Content="Open" Click="Open_Click" />
            <Button Content="Save" Click="Save_Click" />
            <Button Content="Save As" Click="SaveAs_Click" />
            <Button Content="Render" Click="Render_Click" />
            <Button Content="Zoom In" Click="ZoomIn_Click" />
            <Button Content="Zoom Out" Click="ZoomOut_Click" />
            <Button Content="Toggle Editor Theme" Click="ToggleEditorTheme_Click" />
            <Button Content="Toggle Preview Theme" Click="TogglePreviewTheme_Click" />
        </ToolBar>
    </Grid>
</Window>